# ─────────────────────────────────────────────────────────────────────────────
# Cricket Team Maker — environment variables
#
# Copy this file to `.env` (either next to this file in app/, or at the project
# root — both are found). NEVER commit `.env`; it is gitignored.
# In production (Render) set the same variables in Dashboard → Environment and
# mark the secret ones as secret. Nothing here is read from the repo.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# Where to find all of these:
#   Supabase Dashboard → your project → Project Settings → API Keys
#   (the "Publishable and secret API keys" tab — NOT the "Legacy" tab)

# REQUIRED. Project URL, e.g. https://abcdefghijklmnop.supabase.co
#   Dashboard → Project Settings → Data API → Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# REQUIRED. Secret key — starts with `sb_secret_`.
#   SERVER ONLY. Bypasses Row Level Security, so treat it like a database password:
#   never put it in front-end code, never commit it, never share it in chat.
#   The app refuses to start if you paste a publishable/anon key here by mistake.
#   (A legacy service_role JWT starting with `eyJ` still works during migration.)
SUPABASE_SECRET_KEY=sb_secret_your-secret-key-here

# OPTIONAL. Publishable key — starts with `sb_publishable_`.
#   Safe to expose: the server injects it into the page so the browser can run
#   Supabase Auth (sign in / sign up / profile / password reset). Without it the
#   app still works fully as a guest — only the sign-in chip is disabled.
#   Formerly called SUPABASE_ANON_KEY; that old name is still accepted as a fallback.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# ── Admin page (/admin) ──────────────────────────────────────────────────────
# OPTIONAL but needed to use /admin (day events, grounds, visitor stats).
#   Use 12+ random characters. If unset, admin login is disabled (returns 503) —
#   there is no default password.
#   Changing it logs out every admin session.
#   Generate one:  python -c "import secrets; print(secrets.token_urlsafe(18))"
ADMIN_PASSWORD=choose-a-long-random-password

# ── Visitor analytics ────────────────────────────────────────────────────────
# OPTIONAL. Secret salt used to hash visitor IPs (raw IPs are never stored).
#   Falls back to SUPABASE_SECRET_KEY if unset. Changing it makes returning
#   visitors count as new ones (unique-visitor continuity resets).
#   Generate one:  python -c "import secrets; print(secrets.token_urlsafe(24))"
VISITOR_HASH_SALT=any-long-random-string
